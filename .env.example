# Copy to .env (repo root or task3_agentic/) and fill in. Never commit .env.
# In Colab, add the same names under Secrets (key icon) instead.

# --- Required -------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Model (change here; no code changes needed) ---------------------------
OPENROUTER_MODEL=openai/gpt-4o
# Model used inside the llm_sentiment tool (defaults to OPENROUTER_MODEL)
OPENROUTER_SENTIMENT_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=4
# Max output tokens per call. OpenRouter checks your credit against this value,
# so keep it modest (2048 is enough for every response in this project).
LLM_MAX_TOKENS=2048
# Optional OpenRouter attribution headers
OPENROUTER_APP_URL=https://github.com/
OPENROUTER_APP_NAME=CDAZZDEV Task 3 Agentic Research

# --- Agent behaviour ---------------------------------------------------------
DEFAULT_TICKER=NVDA
MAX_TOOL_CALLS=10
MAX_CLARIFICATION_ROUNDS=2
GRAPH_RECURSION_LIMIT=60

# --- Storage (relative paths are inside task3_agentic/) -----------------------
TRACE_PATH=logs/agent_trace.jsonl
CACHE_DIR=cache

# --- Demo: comma-separated tool names to force-fail at startup ----------------
FAIL_TOOLS=

# --- Optional bonus: LangSmith tracing ----------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cdazzdev-task3
